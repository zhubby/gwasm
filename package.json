    "test:e2e": "node tests/e2e.js"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2",
    "playwright": "1.55.1",
    "typescript": "5.9.3"
  }
}
